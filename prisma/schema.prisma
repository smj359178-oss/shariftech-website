generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// محصولات و راهکارها (AI Agents / Dashboards / Smart Systems / Custom)
// ---------------------------------------------------------------------------
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String   @default("")
  category    String   @default("AI_AGENT") // AI_AGENT | DASHBOARD | SMART_SYSTEM | CUSTOM
  summary     String   @default("")
  description String   @default("")
  features    String   @default("[]") // JSON array of strings
  useCases    String   @default("[]") // JSON array of { title, description }
  techStack   String   @default("[]") // JSON array of strings
  image       String   @default("") // مسیر تصویر محصول داخل /public (بدون وابستگی خارجی)
  icon        String   @default("Cpu") // lucide icon name
  accent      String   @default("emerald") // emerald | amber | violet | rose | cyan | teal
  featured    Boolean  @default(false)
  status      String   @default("PUBLISHED") // PUBLISHED | DRAFT
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sort])
  @@index([category])
}

// ---------------------------------------------------------------------------
// پیام‌های فرم تماس / درخواست مشاوره
// ---------------------------------------------------------------------------
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  company   String   @default("")
  subject   String   @default("")
  message   String
  status    String   @default("NEW") // NEW | READ | REPLIED | ARCHIVED
  priority  String   @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  note      String   @default("") // یادداشت داخلی کارشناس
  ip        String   @default("")
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// تنظیمات سایت (رکورد یگانه با id ثابت main)
// ---------------------------------------------------------------------------
model SiteSetting {
  id            String   @id @default("main")
  siteName      String   @default("شرکت فناوری اطلاعات دانشگاه صنعتی شریف")
  siteShortName String   @default("شریف‌تک")
  tagline       String   @default("تحول دیجیتال صنایع با هوش مصنوعی")
  heroTitle     String   @default("هوش مصنوعی در قلب صنایع نفت، گاز و پتروشیمی")
  heroSubtitle  String   @default("از ایجنت‌های هوشمند صنعتی تا داشبوردهای مدیریتی لحظه‌ای؛ ما با پیشرفته‌ترین فناوری‌های هوش مصنوعی، آینده کسب‌وکار شما را می‌سازیم.")
  phone         String   @default("021-66000000")
  email         String   @default("info@shariftech.ir")
  address       String   @default("تهران، خیابان آزادی، دانشگاه صنعتی شریف، پارک علم و فناوری")
  linkedin      String   @default("")
  instagram     String   @default("")
  telegram      String   @default("")
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// کاربران پنل مدیریت — نقش‌ها: ADMIN | EDITOR | SALES | VIEWER
// ---------------------------------------------------------------------------
model AdminUser {
  id               String    @id @default(cuid())
  username         String    @unique
  passwordHash     String
  name             String
  email            String    @default("")
  role             String    @default("VIEWER")
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  passwordUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions Session[]
}

// ---------------------------------------------------------------------------
// نشست‌های ورود (Session Store) — فقط hash توکن نگهداری می‌شود
// ---------------------------------------------------------------------------
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String    @default("")
  ip        String    @default("")

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// لاگ فعالیت‌های پنل مدیریت
// ---------------------------------------------------------------------------
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  entity    String   @default("")
  entityId  String   @default("")
  details   String   @default("")
  user      String   @default("system")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity])
}
